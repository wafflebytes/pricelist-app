# Copy to .env.local and fill in. Never commit .env.local.

# --- Client-safe (exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Server / script only. NEVER expose to the client. ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PROJECT_REF=<project-ref>

# Direct Postgres, for DDL only (scripts/apply-migrations.ts).
# db.<ref>.supabase.co is IPv6-only on many projects; use the session-mode
# pooler (port 5432) in your project's region if you have no IPv6 route.
# Percent-encode special characters in the password ('@' -> %40).
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Seed / provisioning inputs ---
SEED_LEDGER_XLSX=/absolute/path/to/Price List App (2).xlsx
SEED_BATCH=signify-2026-07-26
SEED_OWNER_EMAIL=sales@aalino.com
SEED_OWNER_PASSWORD=<password for the first account>
